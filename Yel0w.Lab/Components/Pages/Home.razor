@page "/"

<h1>Yel0w's Lab</h1>

<p class="lead mt-3">Welcome to my Lab! This is a place where I experiment with various technologies.</p>

<div class="row mt-4">
    <div class="col-md-6 mb-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title">Experiments</h5>
                <p class="card-text text-muted">Browse, download, and run experiments from the collection.</p>
                <a href="experiments" class="btn btn-primary">View Experiments</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title">Settings</h5>
                <p class="card-text text-muted">Manage cache and application settings.</p>
                <a href="settings" class="btn btn-outline-secondary">Open Settings</a>
            </div>
        </div>
    </div>
</div>
